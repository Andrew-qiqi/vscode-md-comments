{
  "name": "vscode-md-comments",
  "displayName": "VSCode MD Comments",
  "description": "Notion-style review comments stored as CriticMarkup. AI-friendly format for LLM-assisted editing.",
  "version": "1.0.4",
  "publisher": "andrew-qiqi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrew-qiqi/vscode-md-comments.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:markdown",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "review-comments.add",
        "title": "Add Comment to Selection",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "review-comments.resolve",
        "title": "Resolve Comment"
      },
      {
        "command": "review-comments.edit",
        "title": "Edit Comment"
      }
    ],
    "keybindings": [
      {
        "command": "review-comments.add",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorHasSelection && editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "review-comments.add",
          "when": "editorHasSelection && editorLangId == markdown",
          "group": "1_modification"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "review-comments-explorer",
          "title": "MD Comments",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "review-comments-explorer": [
        {
          "type": "webview",
          "id": "review-comments-sidebar",
          "name": "Review Comments",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Review Comments",
      "properties": {
        "review-comments.authorName": {
          "type": "string",
          "default": "you",
          "description": "Name recorded in comments."
        },
        "review-comments.dateFormat": {
          "type": "string",
          "enum": [
            "iso",
            "japanese"
          ],
          "default": "iso",
          "description": "Date format."
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ],
    "markdown.previewScripts": [
      "./media/preview.js"
    ]
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  }
}
